# StretchMetal — environment variables
# Copy this file to .env.local for local dev, and add the same vars in
# Vercel → Project Settings → Environment Variables for production.
#
# Every variable is OPTIONAL — the site builds, runs and deploys with none
# of them set. Without the MS_GRAPH_* block the RFQ API logs a submission
# summary to the server console (file names + sizes, never contents) and
# still returns success, so the form works end-to-end without mail config.

# Site URL — canonical links, hreflang alternates, sitemap, and JSON-LD
# absolute URLs. Set after the domain purchase. [CONFIRM] domain
NEXT_PUBLIC_SITE_URL=https://stretchmetal.pl

# Microsoft Graph — sends RFQ/contact emails (with drawing attachments)
# and the localized auto-reply via Microsoft 365.
# Setup: register an app in Microsoft Entra, grant Mail.Send (Application)
# permission, then restrict it with an Exchange Online Application Access
# Policy so a leaked secret can only send from this one mailbox.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_FROM_ADDRESS=info@stretchmetal.pl

# Inbox that receives RFQ + contact submissions.
# Falls back to MS_GRAPH_FROM_ADDRESS, then to siteConfig.contact.email.
RFQ_DESTINATION=

# PostHog — product analytics + session replay (EU cloud)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Microsoft Clarity — free heatmaps + session replay
NEXT_PUBLIC_CLARITY_ID=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=

# Meta (Facebook/Instagram) Pixel — rfq_submitted/cta_click map to Lead,
# phone_click to Contact (see lib/analytics.ts)
NEXT_PUBLIC_META_PIXEL_ID=

# Search engine verification (Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
